{
	"schemaVersion": 1,
	"id": "scriptpacks",
	"version": "${version}",
	"name": "Scriptpacks",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://github.com/firesquid6/scriptpacks",
		"sources": "https://github.com/firesquid6/scriptpacks"
	},
	"license": "CC0-1.0",
	"icon": "assets/scriptpacks/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.jdeiss.scriptpacks.ScriptpacksMod"
		],
		"client": [
			"com.jdeiss.scriptpacks.client.ScriptpacksModClient"
		]
	},
	"mixins": [
		"scriptpacks.mixins.json",
		{
			"config": "scriptpacks.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
