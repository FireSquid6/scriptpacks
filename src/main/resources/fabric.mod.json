{
	"schemaVersion": 1,
	"id": "scriptpacks",
	"version": "${version}",
	"name": "Scriptpacks",
	"description": "Server-side scripting platform — TypeScript/Bun scriptpacks with RPC bridge to game state",
	"authors": [
		"jdeiss"
	],
	"contact": {
		"homepage": "https://github.com/firesquid6/scriptpacks",
		"sources": "https://github.com/firesquid6/scriptpacks"
	},
	"license": "CC0-1.0",
	"icon": "assets/scriptpacks/icon.png",
	"environment": "server",
	"entrypoints": {
		"server": [
			"com.jdeiss.scriptpacks.ScriptpacksMod"
		]
	},
	"mixins": [
		"scriptpacks.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
